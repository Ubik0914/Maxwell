{
  "name": "synedge",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./apps/web --filter=./apps/worker --filter=./apps/mcp run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "DATABASE_URL_TEST=${DATABASE_URL_TEST:-postgres://synedge:synedge@localhost:5432/synedge_test} vitest run --project database",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "db:migrate": "pnpm --filter @synedge/database run migrate",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  }
}
