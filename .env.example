NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web push. Optional: without these the app runs exactly as before and
# the notifications switch in Settings says it is unavailable.
#
#   npx web-push generate-vapid-keys
#
# The pair is permanent — every subscription is made against the public
# half, so replacing it silences every device already subscribed.
# VAPID_SUBJECT is how a push service reaches the sender; a mailto: or
# an https: URL, and it defaults to this project's repository.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Mail (/mail, src/mail — formerly Synedge). Optional: unset, the mail
# screens say "not set up yet" and everything else works as before.
# Setup, in order, is in docs/mail.md.
#
# APP_ORIGIN is this deployment's origin (no /mail), used for OAuth
# redirects and the Origin check. MAIL_ALLOWED_EMAILS: the Gmail
# addresses that may be connected, comma-separated.
APP_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_ALLOWED_EMAILS=
# 32+ random characters: signs the OAuth state and the Android ticket.
#   openssl rand -base64 48
MAIL_OAUTH_SECRET=
# Gmail tokens are stored encrypted with this (AES-256-GCM).
#   echo "1:$(openssl rand -base64 32)"
MAIL_TOKEN_ENCRYPTION_KEYS=
# Supabase → Connect → Transaction pooler (port 6543). Server-only.
MAIL_DATABASE_URL=
# New-mail notifications (Gmail watch → Pub/Sub → /mail/api/pubsub/gmail)
GMAIL_PUBSUB_TOPIC=
PUBSUB_SERVICE_ACCOUNTS=
PUBSUB_AUDIENCE=
# Firebase service account JSON (base64 is fine) for Android push.
FCM_SERVICE_ACCOUNT_JSON=
# Vercel Cron sends this as a bearer token to /mail/api/jobs/*.
CRON_SECRET=
