NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web push. Optional: without these the app runs exactly as before and
# the notifications switch in Settings says it is unavailable.
#
#   npx web-push generate-vapid-keys
#
# The pair is permanent — every subscription is made against the public
# half, so replacing it silences every device already subscribed.
# VAPID_SUBJECT is how a push service reaches the sender; a mailto: or
# an https: URL, and it defaults to this project's repository.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
